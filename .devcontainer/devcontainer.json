{
    "name": "SFG Zenoh Domain Bridge",
    "dockerComposeFile": "${localWorkspaceFolder}/.devcontainer/compose.yaml",
    "service": "sfg_zenoh_domain_bridge",
    "overrideCommand": true,
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "settings": {
                // General settings.
                "editor.formatOnSave": true,
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.egg-info": true,
                    "**/.mypy_cache": true
                },
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash",
                        "args": [
                            "--login"
                        ]
                    }
                },
                "workbench.view.showQuietly": {
                    "workbench.panel.output": true
                },
                "docker.languageserver.formatter.ignoreMultilineInstructions": true,
                "docker.lsp.experimental.vulnerabilityScanning": false,
                "docker.extension.dockerEngineAvailabilityPrompt": false,
                // Python settings.
                "python.languageServer": "Pylance",
                "debugpy.debugJustMyCode": false,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                },
                "mypy-type-checker.args": [
                    "--config-file=${containerWorkspaceFolder}/.vscode/mypy.ini"
                ]
            },
            "extensions": [
                // General extensions.
                "eamodio.gitlens",
                "GitHub.copilot",
                "ms-azuretools.vscode-docker",
                "redhat.vscode-yaml",
                "tamasfe.even-better-toml",
                // Python extensions.
                "charliermarsh.ruff",
                "ms-python.mypy-type-checker",
                "ms-python.python",
                "njpwerner.autodocstring"
            ]
        }
    }
}